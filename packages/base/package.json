{
  "name": "@openobserve/openobserve-ci-base",
  "version": "5.21.1",
  "description": "Base package for OpenObserve CI",
  "license": "Apache-2.0",
  "keywords": [
    "datadog",
    "openobserve-ci"
  ],
  "homepage": "https://github.com/DataDog/openobserve-ci/tree/master/packages/base",
  "bugs": {
    "url": "https://github.com/DataDog/openobserve-ci/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DataDog/openobserve-ci.git",
    "directory": "packages/base"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "development": "./src/cli.ts",
      "default": "./dist/cli.js"
    },
    "./commands/*": {
      "development": "./src/commands/*.ts",
      "default": "./dist/commands/*.js"
    },
    "./constants": {
      "development": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "./helpers/request/*": {
      "development": "./src/helpers/request/*.ts",
      "default": "./dist/helpers/request/*.js"
    },
    "./helpers/*": {
      "development": "./src/helpers/*.ts",
      "default": "./dist/helpers/*.js"
    },
    "./version": {
      "development": "./src/version.ts",
      "default": "./dist/version.js"
    }
  },
  "files": [
    "dist/**/*",
    "README",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn package:clean; yarn package:build",
    "lint": "yarn package:lint",
    "prepack": "yarn package:clean-dist"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {},
  "dependencies": {
    "@antfu/install-pkg": "^1.1.0",
    "@types/datadog-metrics": "^0.6.1",
    "async-retry": "^1.3.3",
    "chalk": "^3.0.0",
    "clipanion": "^3.2.1",
    "datadog-metrics": "^0.9.3",
    "debug": "^4.4.1",
    "deep-extend": "^0.6.0",
    "fast-xml-parser": "^5.7.2",
    "form-data": "^4.0.6",
    "glob": "^13.0.6",
    "inquirer": "^8.2.7",
    "is-docker": "^4.0.0",
    "jest-diff": "^30.2.0",
    "js-yaml": "^4.2.0",
    "jszip": "^3.10.1",
    "proxy-agent": "^6.4.0",
    "semver": "^7.6.3",
    "simple-git": "^3.36.0",
    "terminal-link": "^2.1.1",
    "tiny-async-pool": "^2.1.0",
    "typanion": "^3.14.0",
    "undici": "^7.28.0",
    "upath": "^2.0.1"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.8",
    "@types/debug": "^4.1.12",
    "@types/deep-extend": "^0.4.31",
    "@types/inquirer": "^8.2.6",
    "@types/js-yaml": "^4.0.9",
    "@types/semver": "^7.7.1",
    "@types/tiny-async-pool": "^2.0.3"
  }
}
